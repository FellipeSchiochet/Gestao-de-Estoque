{
  "ConnectionStrings": {
    "DefaultConnection": "Host=<SUPABASE_HOST>;Port=5432;Database=<DATABASE>;Username=<USERNAME>;Password=<PASSWORD>;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Jwt": {
    "Key": "<Your-JWT-Secret-32+Chars>",
    "Issuer": "Estoque.API",
    "Audience": "Estoque.Client",
    "ExpirationMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
